<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:id="@+id/iconWrap"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/ws_on_plum_container"
            tools:src="@drawable/ic_location" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.WS.Title"
            tools:text="Location" />

        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.WS.BodySmall"
            tools:text="So your circle and SOS alerts know where you are." />
    </LinearLayout>

    <ImageView
        android:id="@+id/check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="@color/ws_safe_container"
        android:contentDescription="@string/setup_state_done"
        android:padding="5dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/ws_safe" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/allow"
        style="@style/Widget.WS.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingHorizontal="16dp"
        android:text="@string/setup_allow" />
</LinearLayout>
