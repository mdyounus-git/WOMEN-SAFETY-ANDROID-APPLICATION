<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ws_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/ws_nav_clearance">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ws_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.WS.Title" />

            <TextView
                android:id="@+id/avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/action_profile"
                android:focusable="true"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.WS.Label"
                android:textColor="@color/ws_on_plum_container"
                tools:text="A" />
        </LinearLayout>

        <!-- Greeting -->
        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textAppearance="@style/TextAppearance.WS.Overline"
            tools:text="Monday, 19 October" />

        <TextView
            android:id="@+id/greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.WS.Display"
            tools:text="Good evening,\nAsma" />

        <!-- Status pills -->
        <LinearLayout
            android:id="@+id/pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pillSharing"
                style="@style/WS.Pill"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/ws_surface_soft"
                android:drawableStart="@drawable/bg_dot"
                android:drawableTint="@color/ws_ink_faint"
                android:textColor="@color/ws_ink"
                tools:text="Live location shared with 2" />

            <TextView
                android:id="@+id/pillVolume"
                style="@style/WS.Pill"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/ws_surface_soft"
                android:drawableStart="@drawable/bg_dot"
                android:drawableTint="@color/ws_ink_faint"
                android:textColor="@color/ws_ink"
                tools:text="Volume SOS on" />
        </LinearLayout>

        <!-- SOS stage -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ws_sos_size"
            android:layout_marginTop="18dp">

            <View
                android:layout_width="@dimen/ws_sos_size"
                android:layout_height="@dimen/ws_sos_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_sos_glow"
                android:importantForAccessibility="no" />

            <com.example.womensafety.ui.SosButton
                android:id="@+id/sosButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/sosHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.WS.Body"
            tools:text="Hold for 2 seconds · or hold Volume Up for 6 seconds" />

        <!-- Shown while SOS is running -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sosLiveCard"
            style="@style/Widget.WS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ws_sos_container"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sos_live_title"
                        android:textAppearance="@style/TextAppearance.WS.Title"
                        android:textColor="@color/ws_on_sos_container" />

                    <TextView
                        android:id="@+id/sosTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.WS.Title"
                        android:textColor="@color/ws_on_sos_container"
                        tools:text="02:14" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/statViewers"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statPhotos"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statClips"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/statSms"
                        layout="@layout/view_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sosLiveNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.WS.BodySmall"
                    android:textColor="@color/ws_on_sos_container"
                    tools:text="Camera and microphone are on. Your circle is being alerted." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup progress -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            style="@style/Widget.WS.Card.Plum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/setupProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:indicatorColor="@color/ws_plum"
                    app:indicatorSize="44dp"
                    app:trackColor="@color/ws_surface"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="5dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/setupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.WS.Title"
                        android:textColor="@color/ws_on_plum_container"
                        tools:text="Finish safety setup" />

                    <TextView
                        android:id="@+id/setupText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.WS.BodySmall"
                        android:textColor="@color/ws_on_plum_container"
                        tools:text="4 of 7 done · volume SOS is off" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ws_on_plum_container" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/WS.SectionLabel"
            android:text="@string/home_section_tools" />

        <!-- 2 x 2 tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileCircle"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/tileMap"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileContacts"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/tileEvidence"
                layout="@layout/view_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Safety tip -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WS.Card.Soft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_tip_label"
                    android:textAppearance="@style/TextAppearance.WS.Overline" />

                <TextView
                    android:id="@+id/tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.WS.BodyLarge"
                    tools:text="Share your cab's number plate with your circle before the ride starts." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
