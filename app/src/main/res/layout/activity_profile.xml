<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ws_gutter"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:contentDescription="@string/action_back"
            app:icon="@drawable/ic_back"
            app:iconTint="@color/ws_ink" />

        <!-- Identity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.WS.HeadlineSmall"
                android:textColor="@color/ws_on_plum_container"
                tools:text="AY" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.WS.Headline"
                    tools:text="Asma Younus" />

                <TextView
                    android:id="@+id/phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.WS.Body"
                    tools:text="+91 98765 43210" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit"
                style="@style/Widget.WS.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/profile_edit"
                app:icon="@drawable/ic_edit" />
        </LinearLayout>

        <!-- SMS contacts -->
        <TextView
            style="@style/WS.SectionLabel"
            android:text="@string/profile_section_contacts" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/profile_contacts_desc"
                    android:textAppearance="@style/TextAppearance.WS.BodySmall" />

                <LinearLayout
                    android:id="@+id/contactsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/contactsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="@string/profile_contacts_empty"
                    android:textAppearance="@style/TextAppearance.WS.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addContact"
                    style="@style/Widget.WS.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/profile_add_contact"
                    app:icon="@drawable/ic_person_add" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shortcuts -->
        <TextView
            style="@style/WS.SectionLabel"
            android:text="@string/profile_section_safety" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/openSetup"
                    style="@style/WS.Row"
                    android:drawableStart="@drawable/ic_shield"
                    android:text="@string/profile_setup" />

                <TextView
                    android:id="@+id/openEvidence"
                    style="@style/WS.Row"
                    android:drawableStart="@drawable/ic_lock"
                    android:text="@string/profile_evidence" />

                <TextView
                    android:id="@+id/testVolume"
                    style="@style/WS.Row"
                    android:drawableStart="@drawable/ic_volume_up"
                    android:text="@string/profile_volume_help" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- About -->
        <TextView
            style="@style/WS.SectionLabel"
            android:text="@string/profile_section_privacy" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WS.Card.Soft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4sp"
                android:padding="18dp"
                android:text="@string/profile_privacy_text"
                android:textAppearance="@style/TextAppearance.WS.Body"
                android:textColor="@color/ws_ink" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/Widget.WS.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="@string/profile_reset"
            android:textColor="@color/ws_sos"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/ws_sos" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.WS.BodySmall"
            tools:text="Version 6.0" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
