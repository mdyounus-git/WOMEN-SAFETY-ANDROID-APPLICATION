<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/back"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:contentDescription="@string/action_back"
                app:icon="@drawable/ic_back"
                app:iconTint="@color/ws_ink" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/invite_eyebrow"
            android:textAppearance="@style/TextAppearance.WS.Overline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/invite_title"
            android:textAppearance="@style/TextAppearance.WS.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/invite_body"
            android:textAppearance="@style/TextAppearance.WS.Body" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.WS.Card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="264dp"
                android:layout_height="264dp"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/invite_qr_desc" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center" />

                <!-- Expired / error overlay -->
                <LinearLayout
                    android:id="@+id/overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/overlayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.WS.Title"
                        android:textColor="#1F1524"
                        tools:text="Code expired" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/regenerate"
                        style="@style/Widget.WS.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/invite_new_code"
                        app:icon="@drawable/ic_refresh" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textColor="@color/ws_ink"
            android:textIsSelectable="true"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="ABCD·EFGH·JK" />

        <TextView
            android:id="@+id/expires"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.WS.BodySmall"
            tools:text="Expires in 9:42" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/joinedCard"
            style="@style/Widget.WS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/ws_safe_container"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/joinedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="12dp"
                android:drawableTint="@color/ws_safe"
                android:padding="16dp"
                android:textAppearance="@style/TextAppearance.WS.Title"
                tools:text="Mom joined your circle" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="10dp"
            android:drawableTint="@color/ws_ink_muted"
            android:text="@string/invite_safety_note"
            android:textAppearance="@style/TextAppearance.WS.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share"
            style="@style/Widget.WS.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/invite_share_code"
            app:icon="@drawable/ic_share" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
